# Only needed on Vercel (or anywhere the local filesystem can't be written to).
# When this is NOT set, the app automatically falls back to reading/writing
# the local data/qa.json and data/examples.json files - useful for `npm start`
# on your own machine, no MongoDB account needed just to test locally.
#
# How to get this value:
# 1. Go to https://www.mongodb.com/cloud/atlas/register and create a free
#    account (no credit card needed for the free M0 cluster).
# 2. Create a free "M0" cluster (takes a few minutes to provision).
# 3. Database Access -> add a database user (username + password).
# 4. Network Access -> add IP address 0.0.0.0/0 (allow access from
#    anywhere) so Vercel's servers can reach it.
# 5. Database -> Connect -> "Drivers" -> copy the connection string, and
#    replace <username>/<password> with the user you created in step 3.
# 6. Paste that connection string here (locally) and as the MONGODB_URI
#    environment variable in your Vercel project settings (Settings ->
#    Environment Variables) for production.
MONGODB_URI=

# Optional - defaults to "qa_app" if not set.
MONGODB_DB=
